{
  "name": "@cms/seeds",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./archetypes": "./src/archetypes.ts",
    "./core-library": "./src/core-library.ts",
    "./core-install": "./src/core-install.ts",
    "./core-themes": "./src/core-themes.ts",
    "./core-templates": "./src/core-templates.ts",
    "./echelon-site": "./src/echelon-site.ts",
    "./echelon-chapters": "./src/echelon-chapters.ts",
    "./sawso-home-approved": "./src/sawso-home-approved.ts",
    "./national-library": "./src/national-library.ts",
    "./sawso-stories": "./src/sawso-stories.ts",
    "./sawso-story-tags": "./src/sawso-story-tags.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed": "node --env-file-if-exists=../../.env --experimental-strip-types src/seed-database.ts",
    "core:install": "node --experimental-strip-types src/install-core-library-cli.ts"
  },
  "dependencies": {
    "@cms/schema": "workspace:*",
    "@cms/renderer": "workspace:*",
    "@cms/platform": "workspace:*",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.15.5"
  }
}
