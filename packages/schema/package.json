{
  "name": "@cms/schema",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "node --env-file-if-exists=../../.env --experimental-strip-types src/migrate/cli.ts",
    "db:bootstrap": "node --env-file-if-exists=../../.env --experimental-strip-types scripts/bootstrap.ts",
    "test:db": "vitest run --config vitest.db.config.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "zod": "^4.4.3",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "@types/pg": "^8.15.5"
  },
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./test/harness.ts",
    "./fixtures": "./test/fixtures.ts",
    "./migrate": "./src/migrate/index.ts",
    "./repeat-items": "./src/content/repeat-items.ts",
    "./slot-id": "./src/content/slot-id.ts"
  }
}
