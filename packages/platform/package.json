{
  "name": "@cms/platform",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./perf-trace": "./src/perf-trace.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "revalidate": "node --env-file-if-exists=../../.env --experimental-strip-types src/revalidate-cli.ts",
    "test:db": "vitest run --config vitest.db.config.ts",
    "recovery": "node --env-file-if-exists=../../.env --experimental-strip-types src/recovery-cli.ts"
  },
  "dependencies": {
    "@cms/domain": "workspace:*",
    "@cms/renderer": "workspace:*",
    "@cms/schema": "workspace:*",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "^8.15.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
