{
  "name": "worker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=../../.env --experimental-strip-types src/main.ts",
    "drain": "node --env-file-if-exists=../../.env --experimental-strip-types src/drain.ts",
    "dev": "node --env-file-if-exists=../../.env --experimental-strip-types --watch src/main.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:db": "vitest run --config vitest.db.config.ts"
  },
  "dependencies": {
    "@cms/domain": "workspace:*",
    "@cms/platform": "workspace:*",
    "@cms/renderer": "workspace:*",
    "@cms/schema": "workspace:*",
    "pg": "^8.16.3",
    "playwright": "^1.62.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "^8.15.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
