# Local Postgres. `pnpm db:up` starts it (Docker if available, native otherwise);
# a Supabase project swaps in its own URLs with the same four role separations.

# Migration owner — deployment only. Never used by a running app.
DATABASE_URL=postgres://cms:cms@127.0.0.1:54329/cms_dev

# The four identities from SPEC §4. Each is a distinct Postgres login; there is
# deliberately no shared credential for an app to fall back to.
DATABASE_URL_AUTHENTICATED=postgres://cms_admin_app:devpassword@127.0.0.1:54329/cms_dev
DATABASE_URL_PUBLIC=postgres://cms_site_app:devpassword@127.0.0.1:54329/cms_dev
DATABASE_URL_WORKER=postgres://cms_worker_app:devpassword@127.0.0.1:54329/cms_dev
# Connections per process (default: 10 for the public site, 5 otherwise). Lower
# it on a small hosted database so every service fits its connection limit.
# DATABASE_POOL_MAX=5

# Used by the database policy tests to create and drop per-file databases.
TEST_DATABASE_URL=postgres://cms:cms@127.0.0.1:54329/postgres

# Local auth is restricted to development. Hosted staging/production use supabase.
AUTH_PROVIDER=local
AUTH_SECRET=local-development-secret-change-me
ADMIN_ORIGIN=http://localhost:3000
# Local public app port; leave unset on ordinary HTTPS deployments.
# PUBLIC_SITE_PORT=3001
# Hosted configuration (HTTPS origins, no paths; never use a service-role key):
# AUTH_PROVIDER=supabase
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# ADMIN_ORIGIN=https://cms.example.org
# CMS_LOCAL_TEST_MODE is reserved for loopback-only built-app tests; do not deploy it.
# Configure after wildcard DNS/certificates reach the public-site service:
# STAGING_BASE_DOMAIN=staging.example.org

# Notification delivery. Local mode records messages; hosted workers require a provider.
MAILER_PROVIDER=recording
# Hosted worker only:
# MAILER_PROVIDER=resend
# RESEND_API_KEY=...
# MAIL_FROM=CMS <cms@example.org>

# Only believe X-Forwarded-Host when a configured proxy is actually in front.
TRUST_PROXY_HEADERS=false

APP_VERSION=dev

# Activate only after the worker and its silence/failure alerts are verified.
# The CMS additionally requires a worker heartbeat within the last 60 seconds.
SCHEDULING_ENABLED=false
SCHEDULING_MONITORING_READY=false

# Where the V1 checkout is. Only the importer reads it, and only ever to read:
# V1 is a separate licensed repository and nothing in this one writes to it.
# Unset, `pnpm --filter @cms/importer test` skips the catalogue suite instead of
# passing on an empty read, and the importer CLI refuses to guess.
# V1_ROOT=/path/to/new-builds

# Production adapters. Configure only on the roles noted in docs/operations.md.
# MEDIA_PROVIDER=supabase
# STORAGE_SUPABASE_URL=https://dedicated-storage-project.supabase.co
# STORAGE_SUPABASE_KEY=...
# STORAGE_BUCKET=cms-media
# Explicit persistent-volume alternative (all media-serving roles share the volume):
# MEDIA_PROVIDER=filesystem
# MEDIA_ROOT=/var/lib/cms/media
# DOMAIN_PROVIDER=cloudflare
# CLOUDFLARE_DOMAIN_API_TOKEN=...
# CLOUDFLARE_DOMAIN_ZONE_ID=...
# DOMAIN_CNAME_TARGET=sites.example.org
# DOMAIN_APEX_IPV4=...
# MONITORING_PROVIDER=stdout
# MONITORING_PROVIDER=webhook
# MONITORING_WEBHOOK_URL=https://monitoring.example.org/cms
# MONITORING_WEBHOOK_TOKEN=...
# BACKUP_STATUS_PATH=/backups/latest/status.json

# Operator-only recovery process, never web/worker credentials.
# CMS_BACKUP_KEY=... (base64-encoded random 32-byte secret; see docs/operations.md)
# CMS_PG_BIN=/absolute/path/to/postgresql16/bin
# CMS_RESTORE_DATABASE_URL=postgres://restore_operator:...@127.0.0.1:5432/cms_restore_drill
# CMS_RESTORE_MEDIA_ROOT=/recovery/media/new-drill
# CMS_RESTORE_ISOLATED=true
