{
  "name": "cms-v2",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "typecheck": "pnpm lint:styles && pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:db": "pnpm -r --workspace-concurrency=1 test:db",
    "build": "pnpm -r build",
    "verify": "pnpm check:node && pnpm typecheck && pnpm test && pnpm test:db && pnpm build && pnpm test:e2e",
    "db:up": "sh scripts/local-db.sh",
    "db:down": "sh scripts/stop-local-db.sh",
    "db:migrate": "pnpm --filter @cms/schema migrate",
    "db:bootstrap": "pnpm --filter @cms/schema db:bootstrap",
    "db:seed": "pnpm --filter @cms/seeds seed",
    "dev:admin": "pnpm --filter admin dev",
    "dev:site": "pnpm --filter site dev",
    "dev:worker": "pnpm --filter worker dev",
    "test:e2e": "pnpm --filter e2e test:e2e",
    "test:release": "node --env-file-if-exists=.env scripts/release-browsers.mjs",
    "check:node": "node scripts/check-node.mjs",
    "db:revalidate": "pnpm --filter @cms/platform revalidate",
    "recovery": "pnpm --filter @cms/platform recovery",
    "import:website": "pnpm --filter @cms/importer website",
    "demo": "node scripts/demo.mjs",
    "lint:styles": "stylelint \"apps/admin/src/**/*.css\" --allow-empty-input",
    "library:install": "pnpm --filter @cms/seeds core:install",
    "library:assets": "node scripts/generate-core-assets.mjs",
    "library:thumbnails": "node --experimental-strip-types scripts/generate-core-thumbnails.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,js,cjs,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mjs,js,cjs,css}\"",
    "schema:reference": "node --env-file-if-exists=.env scripts/current-sql.mjs",
    "schema:reference:check": "node --env-file-if-exists=.env scripts/current-sql.mjs --check"
  },
  "devDependencies": {
    "@fontsource/material-symbols-outlined": "5.3.9",
    "@fontsource/open-sans": "5.3.0",
    "@fontsource/source-serif-4": "5.3.1",
    "bootstrap": "5.3.8",
    "esbuild": "0.28.2",
    "prettier": "3.7.4",
    "stylelint": "16.25.0"
  }
}
